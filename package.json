{
  "name": "censo-hospitalario",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "auth:hash": "node scripts/hash-password.mjs",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-data.mjs",
    "db:upgrade": "node --env-file-if-exists=.env.local scripts/upgrade.mjs",
    "test:integration": "node --env-file-if-exists=.env.local tests/integration.mjs",
    "auth:install": "node --env-file-if-exists=.env.local scripts/install-users.mjs",
    "db:census": "node --env-file-if-exists=.env.local scripts/install-census.mjs",
    "test:operations": "node --env-file-if-exists=.env.local tests/operations.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.23.2",
    "next": "16.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
