DATABASE_URL=mysql://usuario:contraseña@host:puerto/censo
DATABASE_SSL=true
# Certificado CA del proveedor si no está en el almacén de confianza de Node.
DATABASE_CA=
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Lista JSON. Crear hashes con npm run auth:hash. No usar contraseñas en texto plano.
AUTH_USERS=[]
